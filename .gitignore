# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# local npm cache (kept in-workspace so installs work under a locked-down profile)
/.npm-cache/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# database (contains real lead + message data)
/db/*.db
/db/*.db-journal
/db/*.db-wal
/db/*.db-shm
/db/*.sqlite
/db/*.sqlite3

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template with no values is safe and useful to commit
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# Anchored to the repo root. As bare words these matched ANY path segment named
# "test"/"prompt", which silently excluded src/app/api/whatsapp/test/ from every
# commit — the route existed locally but was never deployed.
/test
/prompt


server.log
# Skills directory
/skills/

# Generated log exports. These contain real customer phone numbers and email addresses, so
# they must never reach git — the CLI writes them into the working tree by default.
nudge-logs_*.xlsx
nudge-logs_*.csv
*-export.xlsx
*-export.csv
