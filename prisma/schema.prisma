// The app's OWN store, now living in the Simplibank MySQL database.
//
// Three tables only, created once by scripts/create-nudge-tables.mjs:
//   nudge_lead, nudge_config, nudge_message_log
//
// They are deliberately prefixed `nudge_` so they cannot collide with the existing
// business tables (that database already has its own `messagelog`).
//
// IMPORTANT: never run `prisma db push` / `prisma migrate` against this database.
// This schema shares a database with live production data, and schema-push can propose
// destructive changes to tables it does not know about. Any change to these three
// tables must be a hand-reviewed, additive DDL statement.
//
// The external business data (csp_application, csp_docs, ...) is NOT modelled here and
// is read read-only through src/lib/sb-db.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Leads synced from Zoho CRM
model Lead {
  id                     String    @id @default(cuid())
  zohoId                 String    @unique
  fullName               String?
  firstName              String?
  lastName               String?
  email                  String?
  phone                  String?
  mobile                 String?
  company                String?
  businessVertical       String?
  leadStatus             String?
  createdTime            DateTime?
  kycDocumentUploadCount Int?
  ekoCode                String?
  ownerName              String?
  city                   String?
  state                  String?
  country                String?
  leadSource             String?
  lastActivityTime       DateTime?
  lastSyncedAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())

  messageLogs MessageLog[]

  @@index([leadStatus])
  @@index([businessVertical])
  @@map("nudge_lead")
}

// A reusable nudge definition. channel decides how it is delivered:
// email (SMTP) or whatsapp (Meta Cloud API, pre-approved template).
model Nudge {
  id                   String    @id @default(cuid())
  key                  String    @unique
  name                 String
  description          String?   @db.Text
  enabled              Boolean   @default(true)
  channel              String    @default("email") // email | whatsapp
  // Zoho search criteria string; when set, running the nudge syncs leads with it first
  zohoCriteria         String?   @db.Text
  // JSON lead-selection filters applied on local DB:
  // { requireEmail, requirePhone, excludeStatuses[], businessVertical, maxKycCount, minKycCount, createdAfter }
  filters              String    @default("{}") @db.Text
  // email channel
  subjectTemplate      String?   @db.Text
  bodyTemplate         String?   @db.LongText // email: HTML body; whatsapp: reference copy of the Meta template body
  // whatsapp channel
  whatsappTemplateName String? // Meta-approved template name
  whatsappLanguage     String? // template language code, e.g. "en"
  whatsappParams       String?   @db.Text // JSON array of variable sources: ["first_name","company"] -> {{1}}, {{2}}
  maxEmailsPerLead     Int       @default(1)
  followUpDays         Int       @default(0)
  lastRunAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  messageLogs MessageLog[]

  @@map("nudge_config")
}

// One row per message sent (email or whatsapp)
model MessageLog {
  id               String    @id @default(cuid())
  leadId           String?
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  nudgeId          String
  nudge            Nudge     @relation(fields: [nudgeId], references: [id], onDelete: Cascade)
  channel          String    @default("email") // email | whatsapp
  messageNumber    Int       @default(1)
  sheetRowRef      String?   @db.VarChar(512) // e.g. "<sheetUrl>|<email>" — set for sheet-sourced sends
  toEmail          String?
  toPhone          String?
  subject          String?   @db.Text // email only
  templateName     String? // whatsapp template used
  messageId        String?   @db.VarChar(255) // SMTP message-id or WhatsApp wamid (indexed for webhook lookups)
  trackingId       String    @unique // email: pixel id; whatsapp: internal id
  sentOk           Boolean   @default(false)
  sendError        String?   @db.Text
  sentAt           DateTime?
  opened           Boolean   @default(false)
  opensCount       Int       @default(0)
  openedAt         DateTime?
  replied          Boolean   @default(false)
  repliedAt        DateTime?
  // Inbound WhatsApp replies. Added as additive ALTERs (scripts/add-inbound-columns.mjs):
  // the webhook used to mark `replied` without storing what the customer actually said.
  inboundText      String?   @db.Text // most recent inbound message body
  inboundMessages  String?   @db.Text // JSON array of recent inbound messages: [{ at, type, text }]
  inboundAt        DateTime? // when the most recent inbound message arrived
  engagementStatus String    @default("sent") // sent | opened | replied
  createdAt        DateTime  @default(now())

  @@index([leadId, nudgeId])
  @@index([nudgeId, createdAt])
  @@index([messageId(length: 191)])
  @@map("nudge_message_log")
}
