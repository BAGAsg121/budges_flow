// The app's OWN store, now living in the Simplibank MySQL database.
//
// Three tables only, created once by scripts/create-nudge-tables.mjs:
//   nudge_lead, nudge_config, nudge_message_log
//
// They are deliberately prefixed `nudge_` so they cannot collide with the existing
// business tables (that database already has its own `messagelog`).
//
// IMPORTANT: never run `prisma db push` / `prisma migrate` against this database.
// This schema shares a database with live production data, and schema-push can propose
// destructive changes to tables it does not know about. Any change to these three
// tables must be a hand-reviewed, additive DDL statement.
//
// The external business data (csp_application, csp_docs, ...) is NOT modelled here and
// is read read-only through src/lib/sb-db.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Leads synced from Zoho CRM
model Lead {
  id                     String    @id @default(cuid())
  zohoId                 String    @unique
  fullName               String?
  firstName              String?
  lastName               String?
  email                  String?
  phone                  String?
  mobile                 String?
  company                String?
  businessVertical       String?
  leadStatus             String?
  createdTime            DateTime?
  kycDocumentUploadCount Int?
  // Zoho's KYC_Documents_Expected_Count. Added with scripts/add-kyc-expected-column.mjs
  // (additive ALTER only). Needed by the "all documents submitted" rule, which compares this
  // with kycDocumentUploadCount; NULL means "expectation unknown" and never counts as a match.
  kycDocumentsExpectedCount Int?
  ekoCode                String?
  /**
   * Zoho Sign_Agreement, a boolean. NULL means the CRM did not tell us — deliberately distinct from
   * false, so "agreement pending" nudges cannot fire on a lead whose field we never received.
   * Added with scripts/add-sandbox-columns.mjs (additive ALTER only).
   */
  signAgreement          Boolean?
  /** Zoho KYC_Documents_Upload picklist: "-None-" | "Partial Done" | "All Done" | "Re-upload Requested" | "Accepted". */
  kycDocumentsUploadStatus String?
  ownerName              String?
  city                   String?
  state                  String?
  country                String?
  leadSource             String?
  lastActivityTime       DateTime?
  lastSyncedAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())

  // --- V2: engagement scoring and journey tracking -------------------------
  // Added with scripts/add-v2-columns.mjs (additive ALTERs only).
  /** 0..SCORE_MAX, recomputed from MessageLog history on every sync + cron. Reporting only. */
  engagementScore        Int       @default(0)
  scoreLastCalculatedAt  DateTime?
  /** JSON: per-signal point totals, for the score breakdown panel. */
  scoreBreakdown         String?   @db.Text
  /** Date of the first SUCCESSFUL send ever — the clock for time-to-conversion. */
  firstNudgeSentAt       DateTime?
  /** When leadStatus last changed, so timeInPrevStageHours can be computed on the next change. */
  lastStatusChangedAt    DateTime?
  /** Set only when the lead reaches the converted stage: days from firstNudgeSentAt. */
  totalDaysToConvert     Float?

  stageHistory LeadStageHistory[]
  messageLogs  MessageLog[]

  @@index([leadStatus])
  @@index([businessVertical])
  @@index([engagementScore])
  @@map("nudge_lead")
}

/**
 * V2 — one row per detected CRM stage transition for a lead.
 *
 * Written by the Zoho sync when a lead's Lead_Status differs from the stored one. Attribution is
 * PROBABILISTIC, not causal: it records which nudge was last sent before the change, and nothing
 * more. See src/lib/stage-attribution.ts for the rule and its window.
 *
 * Table created with scripts/create-stage-history-table.mjs (CREATE TABLE IF NOT EXISTS only).
 */
model LeadStageHistory {
  id                      String      @id @default(cuid())
  leadId                  String
  lead                    Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus              String?
  toStatus                String
  detectedAt              DateTime    @default(now())
  /** The last nudge sent before this change, when one falls inside the attribution window. */
  triggeredByNudgeId      String?
  triggeredByNudge        Nudge?      @relation(fields: [triggeredByNudgeId], references: [id])
  triggeredByMessageLogId String?
  triggeredByMessageLog   MessageLog? @relation(fields: [triggeredByMessageLogId], references: [id])
  /** Hours spent in fromStatus before transitioning. Null when there is no prior timestamp. */
  timeInPrevStageHours    Float?
  /** Hours between the attributed send and the detected change, for the impact report. */
  hoursSinceNudge         Float?
  /** Denormalised so the impact report needs no join: which message in the sequence. */
  attributedMessageNumber Int?

  @@index([leadId, detectedAt])
  @@index([toStatus])
  @@index([triggeredByNudgeId])
  @@index([detectedAt])
  @@map("nudge_lead_stage_history")
}

// A reusable nudge definition. channel decides how it is delivered:
// email (SMTP) or whatsapp (Meta Cloud API, pre-approved template).
model Nudge {
  id                   String    @id @default(cuid())
  key                  String    @unique
  name                 String
  description          String?   @db.Text
  enabled              Boolean   @default(true)
  channel              String    @default("email") // email | whatsapp
  // Zoho search criteria string; when set, running the nudge syncs leads with it first
  zohoCriteria         String?   @db.Text
  // JSON lead-selection filters applied on local DB:
  // { requireEmail, requirePhone, excludeStatuses[], businessVertical, maxKycCount, minKycCount, createdAfter }
  filters              String    @default("{}") @db.Text
  // email channel
  subjectTemplate      String?   @db.Text
  bodyTemplate         String?   @db.LongText // email: HTML body; whatsapp: reference copy of the Meta template body
  // whatsapp channel
  whatsappTemplateName String? // Meta-approved template name
  whatsappLanguage     String? // template language code, e.g. "en"
  whatsappParams       String?   @db.Text // JSON array of variable sources: ["first_name","company"] -> {{1}}, {{2}}
  maxEmailsPerLead     Int       @default(1)
  followUpDays         Int       @default(0)
  lastRunAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  messageLogs MessageLog[]
  /** V2: stage changes attributed to this nudge. */
  stageHistory LeadStageHistory[]

  @@map("nudge_config")
}

// One row per message sent (email or whatsapp)
model MessageLog {
  id               String    @id @default(cuid())
  leadId           String?
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  nudgeId          String
  nudge            Nudge     @relation(fields: [nudgeId], references: [id], onDelete: Cascade)
  channel          String    @default("email") // email | whatsapp
  messageNumber    Int       @default(1)
  sheetRowRef      String?   @db.VarChar(512) // e.g. "<sheetUrl>|<email>" — set for sheet-sourced sends
  toEmail          String?
  toPhone          String?
  subject          String?   @db.Text // email only
  templateName     String? // whatsapp template used
  messageId        String?   @db.VarChar(255) // SMTP message-id or WhatsApp wamid (indexed for webhook lookups)
  trackingId       String    @unique // email: pixel id; whatsapp: internal id
  sentOk           Boolean   @default(false)
  sendError        String?   @db.Text
  sentAt           DateTime?
  opened           Boolean   @default(false)
  opensCount       Int       @default(0)
  openedAt         DateTime?
  replied          Boolean   @default(false)
  repliedAt        DateTime?
  // Inbound WhatsApp replies. Added as additive ALTERs (scripts/add-inbound-columns.mjs):
  // the webhook used to mark `replied` without storing what the customer actually said.
  inboundText      String?   @db.Text // most recent inbound message body
  inboundMessages  String?   @db.Text // JSON array of recent inbound messages: [{ at, type, text }]
  inboundAt        DateTime? // when the most recent inbound message arrived
  // WhatsApp URL-button click attribution. Meta does not webhook URL-button clicks, so the
  // button points at /api/track/cta/<token> and the destination is stored here per send.
  ctaUrl           String?   @db.Text // where the tracked button should send the recipient
  ctaClicks        Int       @default(0) // how many times the tracked button URL was opened
  ctaClickedAt     DateTime? // when the first click arrived
  engagementStatus String    @default("sent") // sent | opened | replied
  createdAt        DateTime  @default(now())

  /** V2: stage changes attributed to this specific message. */
  stageHistory LeadStageHistory[]

  @@index([leadId, nudgeId])
  @@index([nudgeId, createdAt])
  @@index([messageId(length: 191)])
  @@map("nudge_message_log")
}
