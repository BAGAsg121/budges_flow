# ============================================================================
#  Nudge Engine — environment TEMPLATE
#  Copy to .env for local use, or paste these keys into your host's dashboard
#  (Render → your service → Environment). NEVER commit a real .env:
#  this repository is public and .env is git-ignored for exactly that reason.
# ============================================================================

# --- App's own store (Prisma → MySQL) ---------------------------------------
# The app's three tables (nudge_lead, nudge_config, nudge_message_log) live in the
# same MySQL server as the business data, in their own prefixed tables.
# The "@" in a password MUST be percent-encoded as %40 in this DSN.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/ekodb_icici
PRISMA_LOG_QUERY=false

# --- External Simplibank MySQL (READ-ONLY) ----------------------------------
SB_READ_HOST=
SB_WRITE_HOST=
SB_USER=
SB_PASSWORD=
SB_NAME=
SB_PORT=3306
SB_CONNECTION_LIMIT=5
SB_CONNECT_TIMEOUT_MS=10000
SB_LOG_QUERY=false

# --- App access control (HTTP Basic auth) -----------------------------------
AUTH_ENABLED=true
APP_USERNAME=admin
APP_PASSWORD=

# --- Scheduler ---------------------------------------------------------------
# On a host that sleeps when idle (e.g. Render free) the in-process scheduler
# cannot fire. Keep this false there and drive POST /api/cron/run externally.
SCHEDULER_ENABLED=false
SCHEDULE_INTERVAL_MINUTES=15
SCHEDULE_SYNC_FROM_ZOHO=true
NUDGE_MAX_PER_RUN=50
CRON_SECRET=

# --- Zoho CRM (DC: .in) ------------------------------------------------------
ZOHO_API_BASE=https://www.zohoapis.in/crm/v8
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCESS_TOKEN=

# --- Zoho CRM MCP server ------------------------------------------------------
# Reads CRM data through Zoho's own MCP server instead of the REST API above.
# ZOHO_MCP_URL is the ".../mcp/<server-id>/message" URL Zoho gives you.
# The other three come out of the one-time connect flow: open
#   <APP_BASE_URL>/api/zoho/mcp/connect
# approve the consent screen, and paste the three values it prints.
# ZOHO_MCP_TOKEN is an optional shortcut that skips refresh entirely.
ZOHO_MCP_URL=
ZOHO_MCP_CLIENT_ID=
ZOHO_MCP_CLIENT_SECRET=
ZOHO_MCP_REFRESH_TOKEN=
ZOHO_MCP_TOKEN=
# Must match a redirect URI registered for the client. Defaults to
# <APP_BASE_URL>/api/zoho/mcp/callback
ZOHO_MCP_REDIRECT_URI=
# Optional pins, for when the server's own tool naming differs from the guesswork in
# src/lib/zoho-mcp.ts. ZOHO_MCP_LEADS_ARGS accepts {{criteria}} as a placeholder.
ZOHO_MCP_LEADS_TOOL=
ZOHO_MCP_LEADS_ARGS=

# --- Zoho Mail account (reference / IMAP only) ------------------------------
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_FROM_ADDRESS=
ZOHO_MAIL_SENDER_NAME=
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=

# --- Email transport ---------------------------------------------------------
# auto (default) prefers the Zoho Mail API when it is configured, then SMTP.
# Force one with: smtp | zoho
MAIL_TRANSPORT=auto

# Zoho Mail REST API — how the original n8n flow sent email (no mailbox password needed)
ZOHO_MAIL_API_BASE=https://mail.zoho.in
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_FROM_ADDRESS=
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=

# SMTP fallback (needs a mailbox app password)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Inbound email reply tracking (IMAP) -------------------------------------
IMAP_ENABLED=false
IMAP_HOST=imap.zoho.in
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_REPLY_LOOKBACK_DAYS=7
EMAIL_WEBHOOK_SECRET=

# --- Public base URL used in tracking pixels ---------------------------------
# MUST be publicly reachable, e.g. https://nudge-engine.onrender.com
APP_BASE_URL=
APP_HOST=
PORT=3000

# --- WhatsApp Business Cloud API (Meta) --------------------------------------
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_DEFAULT_CC=91
# ACCESS TOKEN starting with "EAA". NOT the 32-char App Secret.
WHATSAPP_TOKEN=
# Numeric Phone Number ID from WhatsApp Manager — NOT the phone number.
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (reference / webhook subscription).
WHATSAPP_WABA_ID=
# 32-char App Secret — verifies X-Hub-Signature-256 on incoming webhooks only.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_EMPTY_PARAM_FALLBACK=-
# Default template language when a nudge does not set one. Must match the approved
# template exactly — "en" and "en_US" are different locales at Meta.
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Hours to leave a recipient alone after Meta drops a send for its marketing
# frequency cap (131049) or a marketing opt-out (131050). The cap is a rolling
# per-user window, so retrying every scheduler cycle only logs the same failure.
DELIVERY_CAP_BACKOFF_HOURS=24
