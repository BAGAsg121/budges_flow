# ============================================================================
#  Nudge Engine — environment configuration
#  This file is git-ignored (.env*). All credentials belong here, nowhere else.
# ============================================================================

# --- Database (SQLite via Prisma) -------------------------------------------
# Relative to prisma/schema.prisma, so this points at <project>/db/custom.db
DATABASE_URL=file:../db/custom.db
# Set to true to log every SQL query (very noisy, dev only)
PRISMA_LOG_QUERY=false

# --- App access control (HTTP Basic auth) -----------------------------------
# Protects the UI and every API route. The public tracking endpoints
# (/api/track/*) stay open because inboxes and Meta cannot authenticate.
AUTH_ENABLED=true
APP_USERNAME=admin
APP_PASSWORD=jHQp3F_GB95rd7tyHtjyqCJK

# --- Scheduler ---------------------------------------------------------------
# Runs every enabled nudge automatically while the server is up.
SCHEDULER_ENABLED=true
SCHEDULE_INTERVAL_MINUTES=15
# Sync leads from Zoho before each scheduled run
SCHEDULE_SYNC_FROM_ZOHO=true
# Cap messages per nudge per run so a request can never run past its timeout
NUDGE_MAX_PER_RUN=50
# Shared secret for external cron callers: POST /api/cron/run
CRON_SECRET=iZPuh2EIYHvSXSHbiiKyyr7m

# --- Zoho CRM (DC: .in) ------------------------------------------------------
ZOHO_API_BASE=https://www.zohoapis.in/crm/v8
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_CLIENT_ID=1000.H70DLTD3P20IIUVGTQ91NHHUVM3OHS
ZOHO_CLIENT_SECRET=4a446e765c32dd1a1e4d92109af04f27065ae9214d
ZOHO_REFRESH_TOKEN=1000.e31a20983e1e6c670c28c5ecc8f75126.8ac7ebaca230eac95c0796a7454a166d
# Fallback only — access tokens expire in ~1h. Leave empty to always use the
# refresh-token flow above.
ZOHO_ACCESS_TOKEN=

# --- Zoho Mail account (from the original n8n flow; kept for reference/IMAP) --
ZOHO_MAIL_ACCOUNT_ID=1211051000000002002
ZOHO_MAIL_FROM_ADDRESS=do.not.reply@eko.co.in
ZOHO_MAIL_SENDER_NAME=Eko Support
ZOHO_MAIL_CLIENT_ID=1000.40GDBUGT36VITIK2FSIXLUBM5YE51C
ZOHO_MAIL_CLIENT_SECRET=b6f5b6ddc5dece76937cd68d2a5a2bdd601e8f205c
ZOHO_MAIL_REFRESH_TOKEN=1000.abeb5577d460856699efd856c085eee7.6588ae492e9605a548d192ac5e46a548

# --- SMTP for sending emails -------------------------------------------------
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
# Required to actually send: the mailbox login for do.not.reply@eko.co.in
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Eko Support <do.not.reply@eko.co.in>

# --- Inbound email reply tracking (IMAP) -------------------------------------
# When enabled, the scheduler polls this mailbox and marks the matching
# MessageLog as replied (which stops that lead's follow-up sequence).
IMAP_ENABLED=false
IMAP_HOST=imap.zoho.in
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_REPLY_LOOKBACK_DAYS=7
# Secret for the inbound reply webhook: POST /api/track/email
# (x-webhook-secret header, Authorization: Bearer, or ?secret=)
EMAIL_WEBHOOK_SECRET=F9OVIP6a2qRkimkftQhLpY84

# --- Public base URL used in tracking pixels ---------------------------------
# Auto-detected from the incoming request when empty.
APP_BASE_URL=

# --- WhatsApp Business Cloud API (Meta) --------------------------------------
# Sending number: 9599722251 (register as +91 95997 22251 in Meta)
WHATSAPP_DISPLAY_NUMBER=919599722251
WHATSAPP_DEFAULT_CC=91
# System-user token with whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_TOKEN=
# Phone number ID from Meta WhatsApp Manager
WHATSAPP_PHONE_NUMBER_ID=
# Must match the value pasted into the Meta webhook config
WHATSAPP_VERIFY_TOKEN=32G0EljQj_MrKg7l4yuVvgOj
WHATSAPP_API_VERSION=v21.0
# Value sent for a missing template variable. Must not be empty: dropping a value
# would shift every later {{n}} into the wrong slot.
WHATSAPP_EMPTY_PARAM_FALLBACK=-

# --- Original n8n flow settings (parity defaults) ----------------------------
NUDGE_LEGACY_N8N_BASE_URL=https://automaton8n.eko.in
NUDGE_LEGACY_REMINDER_GAP_DAYS=2
NUDGE_LEGACY_MAX_EMAILS_PER_LEAD=3
NUDGE_LEGACY_STOP_AFTER_REPLY=yes

# --- Infinito WhatsApp (legacy n8n provider — NOT used by this app) ----------
# Preserved from the original workflow so nothing is lost if you migrate back.
INFINITO_API_BASE=https://api.goinfinito.com/unified/v2/send
INFINITO_API_KEY=eyJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJJbmZpbml0byIsImlhdCI6MTc3NjkyNTg1NSwic3ViIjoiRWtvX3dhYmFpbzhveHI2OGI4NTZ1OTloIn0.3LwJuVoYfv3_0M6kDlFRq5GS6QSlk9TZbmshOyYAMAM
INFINITO_SENDER=917428655377
INFINITO_TEMPLATE_MOBILE_PENDING=1797806
INFINITO_TEMPLATE_AGREEMENT_PENDING=1797804
INFINITO_TEMPLATE_DOCUMENTS_PENDING=1797984
INFINITO_TEMPLATE_DOCUMENTS_REUPLOAD=1797977
