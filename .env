DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- Zoho CRM (DC: .in) ---
ZOHO_API_BASE=https://www.zohoapis.in/crm/v8
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
# Recommended: set these 3 for auto-refreshing tokens (access tokens expire in ~1h)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Fallback: short-lived access token (will expire, use refresh flow instead)
ZOHO_ACCESS_TOKEN=1000.30462d6fb599f544e01e75c17acb2928.4b88b050863554a0da306b2d0ef169b4

# --- SMTP for sending emails (Zoho Mail default) ---
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Eko EPS <noreply@eko.co>

# Optional: hardcode public base URL used in tracking pixels (auto-detected from request if empty)
APP_BASE_URL=

# --- WhatsApp Business Cloud API (Meta) ---
# Your sending number: 9599722251 (register as +91 95997 22251 in Meta WhatsApp Manager)
WHATSAPP_DISPLAY_NUMBER=919599722251
WHATSAPP_DEFAULT_CC=91
# System user token with whatsapp_business_messaging + whatsapp_business_management scopes
WHATSAPP_TOKEN=
# Phone number ID from Meta WhatsApp Manager (after number registration)
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you invent; must match what you paste in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=mytesttoken
WHATSAPP_API_VERSION=v21.0
