ZOHO_ACCESS_TOKEN=1000.30462d6fb599f544e01e75c17acb2928.4b88b050863554a0da306b2d0ef169b4

# --- SMTP for sending emails (Zoho Mail default) ---
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Eko EPS <noreply@eko.co>

# Optional: hardcode public base URL used in tracking pixels (auto-detected from request if empty)
